# ==============================================================================
#                      CONFIGURAÇÃO DE AMBIENTE - LIBRARY API
# ==============================================================================
# Copie este arquivo para .env e ajuste os valores conforme o seu ambiente:
# cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Configurações da Aplicação Spring Boot
# ------------------------------------------------------------------------------
# Porta exposta para a aplicação
SERVER_PORT=8080

# Perfil ativo do Spring (ex: dev, prod, docker)
SPRING_PROFILES_ACTIVE=prod

# ------------------------------------------------------------------------------
# 2. Configurações do Banco de Dados PostgreSQL
# ------------------------------------------------------------------------------
# Host do banco de dados (use "postgres" para docker-compose ou "localhost" para rodar local)
DB_HOST=postgres

# Porta do banco de dados PostgreSQL
DB_PORT=5432

# Nome do banco de dados a ser criado/conectado
DB_NAME=librarydb

# Usuário de acesso ao PostgreSQL
DB_USER=postgres

# Senha do usuário do PostgreSQL (ATENÇÃO: altere para uma senha forte em produção)
DB_PASSWORD=postgres123

# (Opcional) URL completa JDBC caso deseje sobrepor a montada automaticamente
# SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/librarydb

# ------------------------------------------------------------------------------
# 3. Pool de Conexões HikariCP
# ------------------------------------------------------------------------------
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2

# ------------------------------------------------------------------------------
# 4. Configurações do Hibernate / JPA
# ------------------------------------------------------------------------------
# Estratégia DDL: update, create-drop, validate, none
JPA_DDL_AUTO=update

# Exibir queries SQL no console (true/false)
JPA_SHOW_SQL=true

# Formatar SQL legível nos logs (true/false)
JPA_FORMAT_SQL=true

# ------------------------------------------------------------------------------
# 5. Configurações de Memória da JVM no Container
# ------------------------------------------------------------------------------
JAVA_OPTS=-XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0
