# ==============================================================================
#                      CONFIGURAÇÃO DE AMBIENTE - LIBRARY API
# ==============================================================================
# Copie este arquivo para .env e ajuste os valores conforme o seu ambiente:
# cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Configurações da Aplicação Spring Boot
# ------------------------------------------------------------------------------
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=prod

# ------------------------------------------------------------------------------
# 2. Configurações do Banco de Dados PostgreSQL
# ------------------------------------------------------------------------------
# Host do banco de dados (use "localhost" para rodar localmente na IDE ou "postgres" no compose)
DB_HOST=localhost

# Porta externa do PostgreSQL (5433 evita conflito com Postgres já instalado no Windows)
DB_PORT=5433

# Nome do banco de dados a ser criado/conectado
DB_NAME=librarydb

# Usuário de acesso ao PostgreSQL
DB_USER=postgres

# Senha do usuário do PostgreSQL
DB_PASSWORD=postgres123

# ------------------------------------------------------------------------------
# 3. Pool de Conexões HikariCP
# ------------------------------------------------------------------------------
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2

# ------------------------------------------------------------------------------
# 4. Configurações do Hibernate / JPA
# ------------------------------------------------------------------------------
JPA_DDL_AUTO=update
JPA_SHOW_SQL=true
JPA_FORMAT_SQL=true

# ------------------------------------------------------------------------------
# 5. Configurações de Memória da JVM no Container
# ------------------------------------------------------------------------------
JAVA_OPTS=-XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0
